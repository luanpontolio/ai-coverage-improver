# ==================================
# AI Coverage Improver Configuration
# ==================================
#
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real secrets to version control
#

# ==================
# GitHub App Configuration
# ==================
# Get these values from: https://github.com/settings/apps
GITHUB_APP_ID=your_github_app_id
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# GitHub Personal Access Token (for API access)
# Needs: repo, read:user, read:org permissions
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ==================
# Database
# ==================
# SQLite for development (default)
DATABASE_URL="file:./apps/backend/prisma/data/dev.db"

# PostgreSQL for production (recommended)
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_coverage_improver?schema=public"

# ==================
# Session
# ==================
# Random secret for session encryption (generate with: openssl rand -hex 32)
SESSION_SECRET=your_random_session_secret_min_32_chars

# ==================
# LLM Configuration
# ==================
# OpenAI-compatible API endpoint
LLM_API_BASE=https://api.groq.com/openai/v1
# Alternatives:
# - OpenAI: https://api.openai.com/v1
# - Together AI: https://api.together.xyz/v1
# - OpenRouter: https://openrouter.ai/api/v1

# API Key for LLM service
LLM_API_KEY=your_llm_api_key_here

# Model to use for test generation
LLM_MODEL=llama-3.3-70b-versatile
# Popular alternatives:
# - Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# - Together AI: meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# LLM generation parameters
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.2

# ==================
# Coverage Settings
# ==================
# Path to coverage file in repositories (relative to repo root)
COVERAGE_SOURCE_PATH=coverage/lcov.info

# Coverage threshold percentage (files below this will be flagged)
COVERAGE_THRESHOLD_PCT=80

# ==================
# Server Configuration
# ==================
# Web app URL (for CORS and OAuth callbacks)
WEB_APP_URL=http://localhost:3001

# Backend API port
PORT=3000

# Node environment
NODE_ENV=development
