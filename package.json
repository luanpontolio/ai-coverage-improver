{
  "name": "ai-coverage-improver",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "echo \"TODO: add eslint config\" && exit 0",
    "format": "echo \"TODO: add prettier config\" && exit 0",
    "test": "jest --runInBand --config jest.config.cjs",
    "dev:backend": "pnpm --filter @ai-coverage-improver/backend dev:watch",
    "dev:web": "pnpm --filter @ai-coverage-improver/web dev",
    "build": "echo \"TODO: add build steps\" && exit 0",
    "db:generate": "prisma generate --schema=apps/backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=apps/backend/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=apps/backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema=apps/backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=apps/backend/prisma/schema.prisma",
    "db:seed": "node apps/backend/prisma/seed.js",
    "test:coverage": "jest --runInBand --coverage --config jest.config.cjs",
    "test:backend": "jest --runInBand --config jest.config.cjs apps/backend",
    "test:backend:coverage": "jest --runInBand --coverage --config jest.config.cjs apps/backend",
    "test:backend:watch": "jest --watch --config jest.config.cjs apps/backend"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "prisma": "^6.2.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/platform-express": "^11.1.9",
    "@octokit/rest": "^20.0.2",
    "@prisma/client": "^6.2.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "bullmq": "^5.66.2",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "ioredis": "^5.8.2",
    "next": "^16.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "pnpm": {}
}
