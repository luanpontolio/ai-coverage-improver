generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GithubInstallation {
  id             String   @id @default(cuid())
  installationId String   @unique
  accountType    String
  accountLogin   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  repositories   Repository[]
}

model Repository {
  id              String   @id @default(cuid())
  provider        String
  owner           String
  name            String
  defaultBranch   String
  installationId  String?
  installation    GithubInstallation? @relation(fields: [installationId], references: [installationId])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  coverageSnaps   CoverageSnapshot[]
  improvementJobs ImprovementJob[]
  
  @@unique([provider, owner, name], name: "provider_owner_name")
}

model CoverageSnapshot {
  id                 String   @id @default(cuid())
  repository         Repository @relation(fields: [repositoryId], references: [id])
  repositoryId       String
  ref                String
  commitSha          String?
  coverageSourcePath String
  format             String
  thresholdPct       Float
  createdAt          DateTime @default(now())
  files              CoverageFileMetric[]
  
  @@index([repositoryId, ref])
}

model CoverageFileMetric {
  id               String   @id @default(cuid())
  snapshot         CoverageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId       String
  filePath         String
  coveragePct      Float
  isBelowThreshold Boolean
  
  @@index([snapshotId])
}

model ImprovementJob {
  id                String   @id @default(cuid())
  repository        Repository @relation(fields: [repositoryId], references: [id])
  repositoryId      String
  targetFilePath    String
  status            String   // queued | running | succeeded | failed
  requestedByUserId String?
  createdAt         DateTime @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  failureCode       String?
  failureMessage    String?
  pullRequestUrl    String?
  pullRequestNumber Int?
  executions        AIExecution[]
  
  @@index([repositoryId, targetFilePath, status])
  @@index([status])
}

model AIExecution {
  id          String   @id @default(cuid())
  job         ImprovementJob @relation(fields: [jobId], references: [id])
  jobId       String
  agentType   String
  status      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  metadata    String?
}

