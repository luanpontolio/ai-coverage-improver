{
  "name": "@ai-coverage-improver/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/main.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:llm": "ts-node --transpile-only src/infrastructure/llm/test-llm.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "bullmq": "^5.66.2",
    "connect-redis": "^9.0.0",
    "ioredis": "^5.8.2",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0"
  }
}
